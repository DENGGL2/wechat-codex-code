{
  "name": "wechat-codex-code",
  "version": "1.0.0",
  "description": "Chat with Codex from WeChat - a local bridge for text, voice, images, files, foreground input, and completion notifications",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "postinstall": "npm run build",
    "start": "node dist/main.js",
    "run": "node dist/main.js start",
    "dev": "tsc --watch",
    "test": "node scripts/run-tests.mjs",
    "setup": "node dist/main.js setup",
    "daemon": "bash scripts/daemon.sh"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.0",
    "typescript": "^5.7.0"
  },
  "keywords": ["wechat", "codex", "bridge", "chat", "skill"],
  "author": "DENGGL2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DENGGL2/wechat-codex-code.git"
  }
}
